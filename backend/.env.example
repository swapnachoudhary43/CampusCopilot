# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env and never put a real API key in source code.

# Used to sign login tokens. Use a long random string before any real deployment.
SECRET_KEY=replace-with-a-long-random-string

# How long a login token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# bcrypt cost. Use 12 for normal runs. Tests lower this so the suite stays fast.
BCRYPT_ROUNDS=12

# Leave blank to use backend/storage/campuscopilot.db
DATABASE_URL=

# Leave blank to use backend/storage
STORAGE_DIR=

# sentence-transformers is the real semantic model.
# hash is a deterministic test double. Do not use hash for the viva demo.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cosine similarity cutoff. Chunks below this are not shown as evidence.
# On the DAVV ordinance index (12 Nov 2026): Ordinance 9 page 1 scored 0.54
# and was kept. The canteen question scored 0.2702 and was refused.
# Re-measure if the PDFs or the embedding model change.
SIMILARITY_THRESHOLD=0.48
RETRIEVAL_TOP_K=4

# auto: use Gemini when GEMINI_API_KEY is set, otherwise quote retrieved text.
# retrieval_only: never call Gemini.
# gemini: call Gemini and show a clear error if the call fails.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
